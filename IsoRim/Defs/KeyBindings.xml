<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <KeyBindingCategoryDef>
    <defName>IsoRim</defName>
    <label>IsoRim</label>
    <description>Keys for the 3D view.</description>
  </KeyBindingCategoryDef>

  <KeyBindingDef>
    <defName>R3D_ToggleView</defName>
    <label>toggle 3D view</label>
    <category>IsoRim</category>
    <defaultKeyCodeA>Alpha0</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>R3D_Isometric</defName>
    <label>isometric view on/off</label>
    <category>IsoRim</category>
    <defaultKeyCodeA>Alpha9</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>R3D_TurnLeft</defName>
    <label>turn the view left</label>
    <category>IsoRim</category>
    <defaultKeyCodeA>Q</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>R3D_TurnRight</defName>
    <label>turn the view right</label>
    <category>IsoRim</category>
    <defaultKeyCodeA>E</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>R3D_TiltUp</defName>
    <label>camera angle: more top-down</label>
    <category>IsoRim</category>
    <defaultKeyCodeA>RightBracket</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>R3D_TiltDown</defName>
    <label>camera angle: lower</label>
    <category>IsoRim</category>
    <defaultKeyCodeA>LeftBracket</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>R3D_ToggleRoofs</defName>
    <label>show roofs on/off</label>
    <category>IsoRim</category>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>R3D_ResetCamera</defName>
    <label>reset the camera to the normal isometric view</label>   <!-- Port: also from the flat view and first person -->
    <category>IsoRim</category>
    <defaultKeyCodeA>Backspace</defaultKeyCodeA>   <!-- Port: Backspace and keypad 5 are unbound in the game and Multiplayer -->
    <defaultKeyCodeB>Keypad5</defaultKeyCodeB>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>R3D_LookModifier</defName>
    <label>hold key for the middle button, or the game's own right button</label>   <!-- Port: middleLooks swaps what it
      does with the middle button (drag the map, or free look); with the right-button look, held as the right button goes
      down, the game gets that press at once (View3D, right-button look). Kept short: the keyboard options draw the
      binding buttons over a long label. -->
    <category>IsoRim</category>
    <defaultKeyCodeA>LeftControl</defaultKeyCodeA>
    <defaultKeyCodeB>RightControl</defaultKeyCodeB>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>R3D_FirstPerson</defName>
    <label>first person with the selected person on/off</label>
    <category>IsoRim</category>
    <defaultKeyCodeA>F5</defaultKeyCodeA>
  </KeyBindingDef>

</Defs>
