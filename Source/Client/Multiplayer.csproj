<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- net48 copied package dlls to bin, CopyToRimworld relies on that -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ReleaseVersion>0.6.2</ReleaseVersion>
    <PublicizeAsReferenceAssemblies>false</PublicizeAsReferenceAssemblies>
    <RootNamespace>Multiplayer.Client</RootNamespace>
    <AssemblyName>Multiplayer</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\Languages\English\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.2" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.3" ExcludeAssets="runtime" />
    <PackageReference Include="RestSharp" Version="106.15.0" />
    <PackageReference Include="RimWorld.MultiplayerAPI" Version="0.6.0" />
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(RimWorldDir)/UnityStubs.dll" Private="false" />
    <Reference Include="Waylith" HintPath="$(RimWorldDir)/Waylith.dll" Private="false" />
    <Reference Include="com.rlabrecque.steamworks.net" HintPath="$(RimWorldDir)/com.rlabrecque.steamworks.net.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Remove=".editorconfig" />
    <None Remove="mono_crash.*.json" />
  </ItemGroup>

  <ItemGroup>
    <Publicize Include="Assembly-CSharp;0Harmony;UnityStubs" />
    <DoNotPublicize Include="0Harmony:System.Runtime.CompilerServices.DefaultInterpolatedStringHandler" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MultiplayerLoader\MultiplayerLoader.csproj" />
    <ProjectReference Include="..\Common\Common.csproj" />
  </ItemGroup>

  <ItemGroup>
<!--    <Reference Include="Multiplayer">-->
<!--      <HintPath>bin\Multiplayer.dll_orig</HintPath>-->
<!--    </Reference>-->
  </ItemGroup>

  <PropertyGroup>
    <ModOutputPath>..\..\</ModOutputPath>
  </PropertyGroup>

  <PropertyGroup Label="Normalise stack trace file locations">
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=$(AssemblyName)/</PathMap>
  </PropertyGroup>

  <!-- RimWorld 1.7 layout: 1.7/Assemblies is loaded by the game, 1.7/AssembliesCustom by MultiplayerLoader -->
  <Target Name="CopyToRimworld" AfterTargets="Build">
    <RemoveDir Directories="$(ModOutputPath)1.7\Assemblies;$(ModOutputPath)1.7\AssembliesCustom" />

    <Copy SourceFiles="bin\Multiplayer.dll" DestinationFiles="$(ModOutputPath)1.7\AssembliesCustom\Multiplayer.dll" />
    <Copy SourceFiles="bin\Multiplayer.pdb" DestinationFiles="$(ModOutputPath)1.7\AssembliesCustom\Multiplayer.pdb" />
    <Copy SourceFiles="bin\MultiplayerCommon.dll" DestinationFiles="$(ModOutputPath)1.7\AssembliesCustom\MultiplayerCommon.dll" />
    <Copy SourceFiles="bin\MultiplayerCommon.pdb" DestinationFiles="$(ModOutputPath)1.7\AssembliesCustom\MultiplayerCommon.pdb" />

    <ItemGroup>
      <CopyToRimworld_ItemsToCopy Include="bin\*.dll" Exclude="bin\Multiplayer.dll;bin\MultiplayerCommon.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(CopyToRimworld_ItemsToCopy)" DestinationFolder="$(ModOutputPath)1.7\Assemblies\" />
  </Target>

  <Import Project="PersonalDefinitions.targets" Condition="exists('PersonalDefinitions.targets')" />

</Project>
